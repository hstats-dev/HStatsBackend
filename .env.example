# Runtime
PRODUCTION=false
PORT=3000
SERVER_ALIVE_CHECK_INTERVAL=5
SERVER_ALIVE_TIMEOUT=10

# SQLite database paths
ACCOUNTS_DB=databases/accounts.db
PLUGIN_DB=databases/plugins.db
SERVERS_DB=databases/servers.db
PLUGIN_STATS_DB=databases/plugin_stats.db
IMPORTANT_DATES_DB=databases/important_dates.db
SESSIONS_DIR=databases

# Sessions and account encryption
# Generate strong random values before running in production.
SESSION_SECRET=
ACCOUNT_DATA_KEY=
ACCOUNT_DATA_HMAC_KEY=
ACCOUNT_PASSWORD_PEPPER=

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Discord bot and slash command deployment
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord OAuth login
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
DISCORD_OAUTH_FRONTEND_ORIGIN=http://localhost:5173

# Discord webhooks
DISCORD_BACKUP_WEBHOOK=
DISCORD_BACKUP_WEBHOOK_TIMEOUT_MS=30000
SITE_LOGS_WEBHOOK=
